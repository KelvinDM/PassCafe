rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSupremeUid(uid) {
      return uid == 'OMjgQR2BTlR2UzheRiqF9KMT5Dk1';
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasCafeRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isMaster() {
      return hasCafeRole() && adminDoc().data.role == 'MASTER';
    }

    function isApprentice() {
      return hasCafeRole() && adminDoc().data.role == 'APPRENTICE';
    }

    function isCafeStaff() {
      return isMaster() || isApprentice();
    }

    function isProtectedAdmin() {
      return hasCafeRole() && adminDoc().data.get('protected', false) == true;
    }

    function isString(value) {
      return value is string && value.size() > 0 && value.size() <= 160;
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    function isOptionalNonNegativeNumber(value) {
      return value == null || (value is number && value >= 0);
    }

    function hasOnlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function isValidAdmin(adminId) {
      return request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'inviteId', 'protected', 'displayName', 'photoURL', 'createdAt', 'createdBy', 'updatedAt', 'updatedByUid'])
        && request.resource.data.uid == adminId
        && isString(request.resource.data.email)
        && request.resource.data.role in ['MASTER', 'APPRENTICE']
        && isOptionalString(request.resource.data.get('inviteId', null))
        && request.resource.data.protected is bool
        && isOptionalString(request.resource.data.get('displayName', null))
        && isOptionalString(request.resource.data.get('photoURL', null))
        && isString(request.resource.data.createdAt)
        && isOptionalString(request.resource.data.get('createdBy', null))
        && isString(request.resource.data.updatedAt)
        && isOptionalString(request.resource.data.get('updatedByUid', null));
    }

    function inviteForRequest() {
      return get(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteId));
    }

    function isValidInviteClaim(adminId) {
      return request.auth != null
        && request.auth.uid == adminId
        && isValidAdmin(adminId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.protected == false
        && request.resource.data.inviteId is string
        && inviteForRequest().data.status == 'PENDING'
        && inviteForRequest().data.email == request.auth.token.email
        && inviteForRequest().data.role == request.resource.data.role
        && getAfter(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteId)).data.status == 'ACCEPTED'
        && getAfter(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteId)).data.claimedByUid == request.auth.uid;
    }

    function isValidSupremeProfile(adminId) {
      return request.auth != null
        && isSupremeUid(request.auth.uid)
        && adminId == request.auth.uid
        && isValidAdmin(adminId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'MASTER'
        && request.resource.data.protected == true
        && request.resource.data.inviteId == null;
    }

    function isValidAdminInvite(inviteId) {
      return request.resource.data.keys().hasOnly(['id', 'email', 'role', 'status', 'createdByUid', 'invitedAt', 'answeredAt', 'claimedByUid'])
        && request.resource.data.id == inviteId
        && isString(request.resource.data.email)
        && request.resource.data.role in ['MASTER', 'APPRENTICE']
        && request.resource.data.status in ['PENDING', 'ACCEPTED', 'DECLINED']
        && isString(request.resource.data.createdByUid)
        && isString(request.resource.data.invitedAt)
        && isOptionalString(request.resource.data.answeredAt)
        && isOptionalString(request.resource.data.claimedByUid);
    }

    function isValidSettings() {
      return hasOnlyKeys(['month', 'monthlyFee', 'pixType', 'pixKey', 'pixOwner'])
        && isString(request.resource.data.month)
        && request.resource.data.month.size() <= 40
        && request.resource.data.monthlyFee is number
        && request.resource.data.monthlyFee >= 0
        && request.resource.data.monthlyFee <= 1000
        && isString(request.resource.data.pixType)
        && request.resource.data.pixType.size() <= 40
        && isString(request.resource.data.pixKey)
        && request.resource.data.pixKey.size() <= 160
        && isString(request.resource.data.pixOwner)
        && request.resource.data.pixOwner.size() <= 120;
    }

    function isValidMember(memberId) {
      return hasOnlyKeys(['id', 'name', 'dept', 'status', 'paidAt', 'paymentCount', 'totalContributed', 'lastProfilePaymentMonth', 'lastApprovedPaymentAt', 'createdByUid', 'createdByEmail', 'createdAt', 'updatedByUid', 'updatedByEmail', 'updatedAt'])
        && request.resource.data.id == memberId
        && isString(request.resource.data.name)
        && request.resource.data.name.size() <= 120
        && isString(request.resource.data.dept)
        && request.resource.data.dept.size() <= 80
        && request.resource.data.status in ['PAID', 'UNPAID', 'PENDING']
        && isOptionalString(request.resource.data.paidAt)
        && isOptionalNonNegativeNumber(request.resource.data.paymentCount)
        && isOptionalNonNegativeNumber(request.resource.data.totalContributed)
        && isOptionalString(request.resource.data.lastProfilePaymentMonth)
        && isOptionalString(request.resource.data.lastApprovedPaymentAt)
        && isOptionalString(request.resource.data.createdByUid)
        && isOptionalString(request.resource.data.createdByEmail)
        && isOptionalString(request.resource.data.createdAt)
        && isOptionalString(request.resource.data.updatedByUid)
        && isOptionalString(request.resource.data.updatedByEmail)
        && isOptionalString(request.resource.data.updatedAt);
    }

    function isPublicMemberWrite(memberId) {
      return request.auth != null
        && isValidMember(memberId)
        && request.resource.data.status in ['UNPAID', 'PENDING']
        && request.resource.data.paidAt == null
        && (
          (!exists(/databases/$(database)/documents/passcafeMembers/$(memberId))
            && memberId == request.auth.uid
            && request.resource.data.paymentCount == null
            && request.resource.data.totalContributed == null
            && request.resource.data.lastProfilePaymentMonth == null
            && request.resource.data.lastApprovedPaymentAt == null)
          || (exists(/databases/$(database)/documents/passcafeMembers/$(memberId))
            && (resource.data.get('createdByUid', null) == request.auth.uid || resource.data.get('createdByUid', null) == null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dept', 'status', 'paidAt', 'createdByUid', 'createdByEmail', 'createdAt', 'updatedByUid', 'updatedByEmail', 'updatedAt']))
        )
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email
        && (!exists(/databases/$(database)/documents/passcafeMembers/$(memberId))
          || resource.data.status != 'PAID');
    }

    function isValidPaymentRequest(requestId) {
      return request.resource.data.keys().hasOnly(['id', 'memberId', 'name', 'dept', 'amount', 'month', 'status', 'requestedAt', 'reviewedAt', 'reviewedBy', 'requestedByUid', 'requestedByEmail', 'requestedByName'])
        && request.resource.data.id == requestId
        && isString(request.resource.data.memberId)
        && isString(request.resource.data.name)
        && request.resource.data.name.size() <= 120
        && isString(request.resource.data.dept)
        && request.resource.data.dept.size() <= 80
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000
        && isString(request.resource.data.month)
        && request.resource.data.month.size() <= 40
        && request.resource.data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && request.resource.data.requestedAt is string
        && isOptionalString(request.resource.data.reviewedAt)
        && isOptionalString(request.resource.data.reviewedBy)
        && isOptionalString(request.resource.data.requestedByUid)
        && isOptionalString(request.resource.data.requestedByEmail)
        && isOptionalString(request.resource.data.requestedByName);
    }

    function isPublicPaymentRequest(requestId) {
      return request.auth != null
        && isValidPaymentRequest(requestId)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.requestedByUid == request.auth.uid
        && (
          request.resource.data.requestedByEmail == request.auth.token.email
          || (isProtectedAdmin()
            && request.resource.data.requestedByEmail == null
            && request.resource.data.requestedByName == 'Mestre Supremo')
        )
        && exists(/databases/$(database)/documents/passcafeMembers/$(request.resource.data.memberId))
        && get(/databases/$(database)/documents/passcafeMembers/$(request.resource.data.memberId)).data.createdByUid == request.auth.uid;
    }

    function isValidAuditLog() {
      return request.resource.data.keys().hasOnly(['id', 'action', 'actorUid', 'actorEmail', 'actorName', 'createdAt', 'details'])
        && request.auth != null
        && request.resource.data.id is string
        && request.resource.data.action is string
        && request.resource.data.actorUid == request.auth.uid
        && (
          request.resource.data.actorEmail == request.auth.token.email
          || (isProtectedAdmin()
            && request.resource.data.actorEmail == null
            && request.resource.data.actorName == 'Mestre Supremo')
        )
        && isOptionalString(request.resource.data.actorName)
        && request.resource.data.createdAt is string;
    }

    function isValidClickerUpgrades() {
      return request.resource.data.upgrades is map
        && request.resource.data.upgrades.keys().hasOnly([
          'grinder',
          'barista',
          'double',
          'machine',
          'thermal',
          'delivery',
          'legendary',
          'franchise',
          'tide-press',
          'tropical-kiosk',
          'volcanic-roast',
          'aroma-plant',
          'arabica-garden',
          'barista-swarm',
          'capsule-vault',
          'franchise-hub',
          'lost-bean-route',
          'caffeinated-fleet',
          'cloud-farm',
          'roast-crystal',
          'pharaoh-crown',
          'espresso-transmitter',
          'caffeine-battery',
          'world-market',
          'lunar-harvest',
          'alchemic-board',
          'order-server',
          'barista-network',
          'espresso-blade',
          'thermal-shield',
          'grinding-spell',
          'cafezord-elixir',
          'aroma-hourglass',
          'quantum-clock',
          'stellar-spark',
          'bean-constellation',
          'barista-eye',
          'decaf-skull',
          'galactic-trophy',
          'supreme-target',
          'coinfe-treasure',
          'limitless-card',
          'coffee-megacity',
          'roast-tower',
          'production-cloud',
          'aromatic-database',
          'extraction-loop',
          'universal-sync',
          'caffeine-sun',
          'espresso-moon',
          'multiverse-gift',
          'eternity-blocks'
        ])
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('grinder', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('barista', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('double', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('machine', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('thermal', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('delivery', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('legendary', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('franchise', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('tide-press', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('tropical-kiosk', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('volcanic-roast', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('aroma-plant', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('arabica-garden', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('barista-swarm', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('capsule-vault', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('franchise-hub', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('lost-bean-route', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('caffeinated-fleet', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('cloud-farm', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('roast-crystal', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('pharaoh-crown', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('espresso-transmitter', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('caffeine-battery', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('world-market', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('lunar-harvest', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('alchemic-board', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('order-server', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('barista-network', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('espresso-blade', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('thermal-shield', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('grinding-spell', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('cafezord-elixir', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('aroma-hourglass', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('quantum-clock', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('stellar-spark', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('bean-constellation', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('barista-eye', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('decaf-skull', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('galactic-trophy', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('supreme-target', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('coinfe-treasure', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('limitless-card', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('coffee-megacity', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('roast-tower', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('production-cloud', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('aromatic-database', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('extraction-loop', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('universal-sync', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('caffeine-sun', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('espresso-moon', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('multiverse-gift', null))
        && isOptionalNonNegativeNumber(request.resource.data.upgrades.get('eternity-blocks', null));
    }

    function isValidClickerSave(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'coins', 'total', 'lifetimeBrewed', 'highestGameLevel', 'sceneVariant', 'coinFes', 'coinFesEarned', 'rebirths', 'manualClicks', 'criticalClicks', 'upgrades', 'skills', 'achievements', 'achievementUnlockedAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.lifetimeBrewed is number
        && request.resource.data.lifetimeBrewed >= request.resource.data.total
        && request.resource.data.highestGameLevel is number
        && request.resource.data.highestGameLevel >= 1
        && request.resource.data.sceneVariant is number
        && request.resource.data.sceneVariant >= 0
        && request.resource.data.coinFes is number
        && request.resource.data.coinFes >= 0
        && request.resource.data.coinFesEarned is number
        && request.resource.data.coinFesEarned >= request.resource.data.coinFes
        && request.resource.data.rebirths is number
        && request.resource.data.rebirths >= 0
        && request.resource.data.manualClicks is number
        && request.resource.data.manualClicks >= 0
        && request.resource.data.criticalClicks is number
        && request.resource.data.criticalClicks >= 0
        && request.resource.data.criticalClicks <= request.resource.data.manualClicks
        && isValidClickerUpgrades()
        && request.resource.data.skills is map
        && request.resource.data.skills.keys().hasOnly(['origin', 'rapid', 'automatic', 'supplier', 'critical', 'temporal', 'precision', 'roastery', 'nightshift', 'network', 'warehouse', 'pilgrimage', 'legacy'])
        && isOptionalNonNegativeNumber(request.resource.data.skills.origin)
        && isOptionalNonNegativeNumber(request.resource.data.skills.rapid)
        && isOptionalNonNegativeNumber(request.resource.data.skills.automatic)
        && isOptionalNonNegativeNumber(request.resource.data.skills.supplier)
        && isOptionalNonNegativeNumber(request.resource.data.skills.critical)
        && isOptionalNonNegativeNumber(request.resource.data.skills.temporal)
        && isOptionalNonNegativeNumber(request.resource.data.skills.precision)
        && isOptionalNonNegativeNumber(request.resource.data.skills.roastery)
        && isOptionalNonNegativeNumber(request.resource.data.skills.nightshift)
        && isOptionalNonNegativeNumber(request.resource.data.skills.network)
        && isOptionalNonNegativeNumber(request.resource.data.skills.warehouse)
        && isOptionalNonNegativeNumber(request.resource.data.skills.pilgrimage)
        && isOptionalNonNegativeNumber(request.resource.data.skills.legacy)
        && request.resource.data.achievements is list
        && request.resource.data.achievements.size() <= 50
        && request.resource.data.achievementUnlockedAt is map
        && request.resource.data.achievementUnlockedAt.size() <= 50
        && request.resource.data.updatedAt is string;
    }

    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list: if false;
      allow create: if isValidSupremeProfile(adminId) || isValidInviteClaim(adminId);
      allow update: if isValidSupremeProfile(adminId)
        || (isMaster()
          && adminId != request.auth.uid
          && exists(/databases/$(database)/documents/adminDirectory/$(adminId))
          && isValidAdmin(adminId)
          && request.resource.data.protected == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt', 'updatedByUid'])
          && request.resource.data.updatedByUid == request.auth.uid);
      allow delete: if isMaster()
        && adminId != request.auth.uid
        && exists(/databases/$(database)/documents/adminDirectory/$(adminId))
        && resource.data.get('protected', false) == false;
    }

    match /adminInvites/{inviteId} {
      allow read: if isMaster()
        || (request.auth != null && resource.data.email == request.auth.token.email);
      allow create: if isMaster()
        && isValidAdminInvite(inviteId)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.answeredAt == null
        && request.resource.data.claimedByUid == null;
      allow update: if request.auth != null
        && resource.data.status == 'PENDING'
        && resource.data.email == request.auth.token.email
        && isValidAdminInvite(inviteId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answeredAt', 'claimedByUid'])
        && request.resource.data.status in ['ACCEPTED', 'DECLINED']
        && request.resource.data.claimedByUid == request.auth.uid;
      allow delete: if isMaster();
    }

    match /adminDirectory/{adminId} {
      allow read: if isMaster();
      allow create: if isValidInviteClaim(adminId)
        && getAfter(/databases/$(database)/documents/admins/$(adminId)).data.role == request.resource.data.role
        && getAfter(/databases/$(database)/documents/admins/$(adminId)).data.email == request.resource.data.email;
      allow update: if isMaster()
        && adminId != request.auth.uid
        && isValidAdmin(adminId)
        && request.resource.data.protected == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/admins/$(adminId)).data.role == request.resource.data.role;
      allow delete: if isMaster()
        && adminId != request.auth.uid
        && get(/databases/$(database)/documents/admins/$(adminId)).data.get('protected', false) == false;
    }

    match /passcafe/settings {
      allow read: if true;
      allow create, update: if isMaster() && isValidSettings();
      allow delete: if false;
    }

    match /passcafeMembers/{memberId} {
      allow read: if true;
      allow create, update: if (isCafeStaff() && isValidMember(memberId)) || isPublicMemberWrite(memberId);
      allow delete: if request.auth != null
        && (isMaster()
          || (resource.data.createdByUid == request.auth.uid
            && resource.data.status != 'PAID'));
    }

    match /paymentRequests/{requestId} {
      allow read: if isCafeStaff();
      allow create: if isPublicPaymentRequest(requestId);
      allow update: if isCafeStaff() && isValidPaymentRequest(requestId);
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isCafeStaff();
      allow create: if isValidAuditLog();
      allow update, delete: if false;
    }

    match /clickerSaves/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isValidClickerSave(userId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
